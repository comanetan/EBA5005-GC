{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "0 · Set up Python environment",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Install modelling libraries (LightGBM, SHAP, lifelines, statsmodels, PuLP, Streamlit)",
      "type": "shell",
      "command": ".venv/bin/pip install -r requirements-models.txt",
      "problemMatcher": []
    },
    {
      "label": "1 · Unique addresses (offline)",
      "type": "shell",
      "command": ".venv/bin/python src/01_unique_addresses.py",
      "problemMatcher": []
    },
    {
      "label": "1b · Clean + validate resale data (offline)",
      "type": "shell",
      "command": ".venv/bin/python src/01b_clean_resale.py",
      "problemMatcher": []
    },
    {
      "label": "2 · Geocode with OneMap (needs internet, ~45 min, resumable)",
      "type": "shell",
      "command": ".venv/bin/python src/02_geocode_onemap.py",
      "problemMatcher": []
    },
    {
      "label": "3 · Amenity points (offline)",
      "type": "shell",
      "command": ".venv/bin/python src/03_amenity_points.py",
      "problemMatcher": []
    },
    {
      "label": "4 · Build features + profiles (after step 2)",
      "type": "shell",
      "command": ".venv/bin/python src/04_build_features.py",
      "problemMatcher": []
    },
    {
      "label": "4b · Validate geocoding + features (offline)",
      "type": "shell",
      "command": ".venv/bin/python src/04b_validate_features.py",
      "problemMatcher": []
    },
    {
      "label": "5 · Price index v0 (offline)",
      "type": "shell",
      "command": ".venv/bin/python src/05_price_index_v0.py",
      "problemMatcher": []
    },
    {
      "label": "6 · Hedonic prices (LightGBM, needs modelling libraries)",
      "type": "shell",
      "command": ".venv/bin/python src/06_hedonic_prices.py",
      "problemMatcher": []
    },
    {
      "label": "7 · Expected wait (survival, needs modelling libraries)",
      "type": "shell",
      "command": ".venv/bin/python src/07_expected_wait.py",
      "problemMatcher": []
    },
    {
      "label": "Backtest: re-run steps 6 + 7 as of a past month",
      "type": "shell",
      "command": ".venv/bin/python src/06_hedonic_prices.py ${input:asOf} && .venv/bin/python src/07_expected_wait.py ${input:asOf}",
      "problemMatcher": []
    },
    {
      "label": "Run steps 1 → 4 in order",
      "dependsOrder": "sequence",
      "dependsOn": [
        "1 · Unique addresses (offline)",
        "1b · Clean + validate resale data (offline)",
        "2 · Geocode with OneMap (needs internet, ~45 min, resumable)",
        "3 · Amenity points (offline)",
        "4 · Build features + profiles (after step 2)"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "asOf",
      "type": "promptString",
      "description": "As-of month (YYYY-MM)",
      "default": "2023-06"
    }
  ]
}
